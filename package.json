{
  "name": "dynamic-website-analyzer",
  "version": "0.1.0",
  "private": true,
  "description": "Records how a website behaves at runtime: DOM, CSS, network, console, and interactions, exported as an inspectable session.",
  "type": "module",
  "bin": {
    "analyzer": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "record": "tsx src/cli.ts record",
    "explore": "tsx src/cli.ts explore",
    "test": "tsx tests/smoke.ts",
    "test:explore": "tsx tests/smoke-explore.ts",
    "serve": "tsx src/server/index.ts",
    "dashboard:dev": "npm run dev --prefix dashboard",
    "dashboard:build": "npm run build --prefix dashboard",
    "seed-dashboard-data": "tsx scripts/seed-dashboard-data.ts",
    "postinstall": "playwright install chromium"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "playwright": "^1.47.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.7.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
